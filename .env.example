# Qloo hackathon key (from the event email). Never commit the real value.
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com
# Optional: an OpenAI-compatible LLM for reading plan text and writing the memo.
# Defaults to NVIDIA Nemotron on Nebius Token Factory. Without it, keyword rules and a template are used.
LLM_API_KEY=
LLM_BASE_URL=https://api.tokenfactory.nebius.com/v1
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
